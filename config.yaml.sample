# SSH Bastion server configuration
# Copy this file to config.yaml and edit to match your environment.

# Address to listen on (host:port or :port)
listen_addr: ":2222"

# Path to the host key file (generated automatically if missing)
host_key_path: "host_key"

# Users authorized to connect to the bastion (identified by SSH public key)
# The "name" becomes the default username when connecting to targets.
users:
  - name: "deploy"
    key: "ssh-ed25519 AAAA... user@host"
    groups:
      - "admin"

  - name: "alice"
    key: "ssh-ed25519 AAAA... alice@host"
    groups:
      - "dev"

# Target hosts available through the bastion
# Only users in the listed groups can see and connect to each target.
targets:
  - name: "Web Server"
    host: "192.168.1.10"
    port: "22"
    allow_groups:
      - "admin"

  - name: "Database Server"
    host: "192.168.1.20"
    port: "5432"
    allow_groups:
      - "admin"
      - "dev"
